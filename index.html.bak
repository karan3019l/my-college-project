  <!-- Section: How It Works (4 Official Steps) -->
  <section id="how-it-works" class="section-py how-it-works-section">
    <div class="container">
      <div class="section-header">
        <span class="section-tag" data-i18n="workflow_tag">Official Roadmap</span>
        <h2 class="section-title" data-i18n="workflow_title">How SchemeMatch Simplifies Applications</h2>
        <p class="section-desc" data-i18n="workflow_desc">
          A transparent 4-step workflow that turns complex government gazettes into actionable student opportunities.
        </p>
      </div>

      <div class="workflow-grid">
        <div class="step-card">
          <div class="step-badge">1</div>
          <h3 class="step-title" data-i18n="step1_title">Enter Profile Details</h3>
          <p class="step-desc" data-i18n="step1_desc">
            Provide your education level, social category, annual family income, state, and special qualifications.
          </p>
        </div>

        <div class="step-card">
          <div class="step-badge">2</div>
          <h3 class="step-title" data-i18n="step2_title">Verify Document Checklist</h3>
          <p class="step-desc" data-i18n="step2_desc">
            Check your certificates (Aadhaar, Income, Caste, Marksheet) against official department requirements.
          </p>
        </div>

        <div class="step-card">
          <div class="step-badge">3</div>
          <h3 class="step-title" data-i18n="step3_title">Get Transparent Match Scores</h3>
          <p class="step-desc" data-i18n="step3_desc">
            Review your personalized eligibility reasons with clear green checkmarks and statutory notes.
          </p>
        </div>

        <div class="step-card">
          <div class="step-badge">4</div>
          <h3 class="step-title" data-i18n="step4_title">Apply on Verified Portals</h3>
          <p class="step-desc" data-i18n="step4_desc">
            Proceed with official portal redirection (NSP, AICTE, Vidya Lakshmi) with your paperwork fully prepared.
          </p>
        </div>
      </div>
    </div>
  </section>

