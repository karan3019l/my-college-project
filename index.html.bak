      <span class="launcher-pulse"></span>
      <span class="launcher-icon">🎙️</span>
      <span class="launcher-label">SevaVaani Co-Pilot</span>
      <span class="launcher-status-dot"></span>
    </button>

    <!-- Sliding Assistant Drawer -->
    <div id="sevavaani-drawer" class="sevavaani-drawer" aria-hidden="true">
      
      <!-- Drawer Header -->
      <div class="sevavaani-header">
        <div class="sevavaani-brand">
          <div class="brand-avatar">🏛️</div>
          <div>
            <h3 class="sevavaani-title">SevaVaani <span>Co-Pilot</span></h3>
            <p class="sevavaani-sub">National Scheme &amp; Form Guide</p>
          </div>
        </div>
        <div class="sevavaani-header-actions">
          <button type="button" id="sevavaani-lang-btn" class="btn-icon" title="Switch Language">🌐 <span id="sevavaani-lang-text">HI</span></button>
          <button type="button" id="sevavaani-sound-btn" class="btn-icon" title="Voice Mute/Unmute">🔊</button>
          <button type="button" id="sevavaani-close-btn" class="btn-icon close-btn" title="Close Assistant" aria-label="Close Assistant">✕</button>
        </div>
      </div>

      <!-- Live Audio Waveform & Status Banner -->
      <div id="sevavaani-wave-bar" class="sevavaani-wave-bar">
        <div class="wave-bars">
          <span></span><span></span><span></span><span></span><span></span><span></span><span></span><span></span>
        </div>
        <span id="sevavaani-live-status" class="live-status-text">Ready to help. Speak or type below.</span>
      </div>

      <!-- Scrollable Message Conversation Stream -->
      <div id="sevavaani-messages" class="sevavaani-messages">
        <!-- Messages injected dynamically by script.js -->
      </div>

      <!-- Quick Suggestion Chips -->
      <div id="sevavaani-chips" class="sevavaani-chips">
        <button type="button" class="chip-btn" data-query="Form kaise bhare?">📝 Form kaise bhare?</button>
        <button type="button" class="chip-btn" data-query="Pragati scheme ke documents kya hai?">📄 Pragati Scheme Documents</button>
        <button type="button" class="chip-btn" data-query="Scholarship ke liye kaha apply kare?">🔗 Kaha Apply Kare?</button>
        <button type="button" class="chip-btn" data-query="Engineering ke liye kaunsi schemes hai?">🎓 Engineering Schemes</button>
        <button type="button" class="chip-btn" data-query="Income criteria kya hai?">💰 Income Limit Rules</button>
      </div>

      <!-- Footer Input Controls (Mic + Text Input + Send) -->
      <div class="sevavaani-input-row">
        <button type="button" id="sevavaani-mic-btn" class="sevavaani-mic-btn" title="Click to speak in Hindi or English">
          <span class="mic-inner-icon">🎙️</span>
        </button>
        <input type="text" id="sevavaani-text-input" class="sevavaani-text-input" placeholder="Poochiye: Form kaise bhare, documents..." autocomplete="off">
        <button type="button" id="sevavaani-send-btn" class="sevavaani-send-btn" title="Send message">→</button>
      </div>

    </div>
  </div>

  <!-- Legacy Compatibility Elements for older scripts -->
  <div style="display:none;" aria-hidden="true">
    <div id="voice-orb"></div>
    <div id="voice-transcript-display"></div>
  </div>

