<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content="SchemeMatch – Scheme Eligibility Platform. Discover scholarships, education loans, and citizen benefits with AI voice assistance.">
  <title>SchemeMatch – Scheme Eligibility Platform</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Noto+Sans+Devanagari:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
</head>
<body class="home-page">

  <!-- Top Tricolor Accent Line (National Civic Standard) -->
  <div class="top-strip" aria-hidden="true"></div>

  <!-- Official Top Bar -->
  <div class="top-bar">
    <div class="container top-bar-content">
      <div class="top-bar-notice">
        <span class="tag" data-i18n="tag_portal">SCHEME ELIGIBILITY PLATFORM</span>
        <span class="top-bar-initiative" data-i18n="top_bar_initiative">Student &amp; Citizen Benefit Discovery Service</span>
      </div>
      <div class="top-bar-right">
        <div class="lang-selector-wrap">
          <label for="site-lang-select" class="lang-label">🌐 <span data-i18n="lang_label">Language:</span></label>
          <select id="site-lang-select" class="lang-dropdown" aria-label="Select Portal Language">
            <option value="en-IN">English</option>
            <option value="hi-IN">हिन्दी (Hindi)</option>
            <option value="mr-IN">मराठी (Marathi)</option>
            <option value="bn-IN">বাংলা (Bengali)</option>
            <option value="ta-IN">தமிழ் (Tamil)</option>
            <option value="te-IN">తెలుగు (Telugu)</option>
          </select>
        </div>
      </div>
    </div>
  </div>

  <!-- Accessibility Toolbar Drawer (Collapsible) -->
  <div id="accessibility-bar" class="accessibility-bar">
    <div class="container accessibility-bar-content">
      <div class="access-tools-title">
        <span>♿</span>
        <strong data-i18n="access_title">Accessibility Tools:</strong>
        <span class="access-desc" data-i18n="access_desc">Adjust text size, contrast, and voice assistance for effortless reading</span>
      </div>
      <div class="access-buttons-row">
        <button type="button" id="font-decrease-btn" class="btn btn-outline btn-sm" title="Decrease font size">A-</button>
        <button type="button" id="font-reset-btn" class="btn btn-outline btn-sm" title="Reset font size">A Default</button>
        <button type="button" id="font-increase-btn" class="btn btn-outline btn-sm" title="Increase font size">A+</button>
        <button type="button" id="high-contrast-btn" class="btn btn-outline btn-sm" title="Toggle High Contrast">🌓 High Contrast</button>
        <button type="button" id="read-page-global-btn" class="btn btn-primary btn-sm" title="Read page aloud">🔊 Read Page</button>
      </div>
    </div>
  </div>

  <!-- Sticky Navigation Header -->
  <header class="site-header">
    <div class="container nav-container">
      <a href="index.html" class="brand-link">
        <div class="brand-emblem">🏛️</div>
        <div class="brand-text">
          <h1 class="brand-title">Scheme<span>Match</span></h1>
          <p class="brand-subtitle" data-i18n="brand_subtitle">Scheme Eligibility Platform</p>
        </div>
      </a>

      <!-- Center navigation -->
      <nav aria-label="Main Navigation">
        <ul class="nav-links">
          <li><a href="index.html" class="nav-link active" data-i18n="nav_home">Home</a></li>
          <li><a href="find-schemes.html" class="nav-link" data-i18n="nav_find">Find Schemes</a></li>
          <li><a href="results.html" class="nav-link" data-i18n="nav_results">Results</a></li>
          <li><a href="#how-it-works" class="nav-link" data-i18n="nav_help">Help</a></li>
          <li><a href="#about" class="nav-link">About</a></li>
        </ul>
      </nav>

      <!-- Right Action Controls -->
      <div class="nav-actions">
        <button type="button" id="voice-assistant-trigger" class="btn btn-voice btn-sm" title="Open SevaVaani Voice Assistant">
          🎙️ <span class="nav-btn-text">SevaVaani Voice Co-Pilot</span>
        </button>
        <button type="button" id="accessibility-toggle-btn" class="btn btn-outline btn-sm" title="Toggle Accessibility Tools">
          ♿ <span class="nav-btn-text" data-i18n="btn_accessibility">Accessibility</span>
        </button>
        <button type="button" class="nav-hamburger" id="nav-hamburger-btn" aria-label="Toggle navigation menu" aria-expanded="false">
          ☰
        </button>
      </div>
    </div>
  </header>

  <!-- Modern Civic Hero Section with Interactive Screener -->
  <section class="hero-wrapper">
    <div class="container">
      <div class="hero-grid">
        
        <!-- LEFT SIDE: Content & Actions -->
        <div class="hero-content">
          <div class="hero-badge-pill">
            <span class="flag-icon">🇮🇳</span>
            <span data-i18n="hero_pill">Direct Ministry Welfare Directory • <span class="dynamic-active-schemes-count">67</span> Verified Active Schemes</span>
          </div>

          <h2 class="hero-heading">Find <span class="hero-heading-highlight">Schemes</span> You May Be Eligible For</h2>

          <p class="hero-desc" data-i18n="hero_desc">
            Discover <span class="dynamic-schemes-count">69</span> verified central &amp; state welfare programs — for farmers, artisans, business owners, workers, women, senior citizens, and students. Check eligibility instantly and apply directly.
          </p>

          <div class="hero-btn-row">
            <a href="find-schemes.html" class="btn btn-primary btn-lg" data-i18n="hero_btn_find">
              Find Matching Schemes (6 Steps) →
            </a>
            <a href="#screener-card" class="btn btn-outline btn-lg" data-i18n="hero_btn_how">
              Quick Eligibility Check ↓
            </a>
          </div>

          <!-- Trust Badges Row -->
          <div class="hero-trust-row">
            <div class="trust-pill-item">
              <span class="trust-check">✓</span> 100% Free Public Portal
            </div>
            <div class="trust-pill-item">
              <span class="trust-check">✓</span> Direct Redirection to NSP / Official Portals
            </div>
            <div class="trust-pill-item">
              <span class="trust-check">✓</span> Multilingual Voice Assistance
            </div>
          </div>

          <div class="hero-voice-advisory">
            <span class="voice-advisory-icon">🎙️</span>
            <div>
              <strong>SevaVaani Voice Co-Pilot Available:</strong>
              <p>Speak in Hindi or English to ask: <em>"PM-KISAN ke liye kya chahiye?", "Ayushman card kaise banaye?", "Mudra loan kaise milega?", "Form kaise bhare?"</em></p>
            </div>
          </div>
        </div>

        <!-- RIGHT SIDE: Interactive Quick Eligibility Screener & Calculator -->
        <div class="hero-interactive-card-wrapper" id="screener-card">
          <div class="hero-screener-card">
            
            <div class="screener-card-header">
              <div class="screener-badge">
                <span class="screener-pulse"></span>
                <span>Live Calculator</span>
              </div>
              <h3 class="screener-title">Quick Citizen Eligibility Check</h3>
              <p class="screener-sub">Select your occupation &amp; income to instantly find matching welfare schemes:</p>
            </div>

            <form class="screener-form" onsubmit="return false;">
              <div class="screener-form-group">
                <label for="hero-screener-occ" class="screener-label">Your Occupation / Livelihood</label>
                <select id="hero-screener-occ" class="screener-select">
                  <option value="All" selected>All Citizens (Any Occupation)</option>
                  <option value="Farmer">🌾 Farmer / Agricultural Worker</option>
                  <option value="Artisan">🔨 Artisan / Traditional Craftsman</option>
                  <option value="Business Owner">💼 Small Business / MSME Owner</option>
                  <option value="Self-Employed">🛒 Self-Employed / Street Vendor</option>
                  <option value="Worker">🏗️ Unorganized / Daily Wage Worker</option>
                  <option value="Woman">👩 Woman / SHG Member / Homemaker</option>
                  <option value="Senior Citizen">👴 Senior Citizen (60+)</option>
                  <option value="Student">🎓 Student / Scholar</option>
                  <option value="Unemployed">🔍 Unemployed / Job Seeker</option>
                </select>
              </div>

              <div class="screener-form-grid">
                <div class="screener-form-group">
                  <label for="hero-screener-cat" class="screener-label">Social Category</label>
                  <select id="hero-screener-cat" class="screener-select">
                    <option value="All">All Categories</option>
                    <option value="OBC" selected>OBC</option>
                    <option value="SC">SC</option>
                    <option value="ST">ST</option>
                    <option value="General">General</option>
                    <option value="EWS">EWS</option>
                  </select>
                </div>

                <div class="screener-form-group">
                  <label for="hero-screener-inc" class="screener-label">Annual Family Income</label>
                  <select id="hero-screener-inc" class="screener-select">
                    <option value="250000" selected>Up to ₹2.5 Lakhs</option>
                    <option value="450000">Up to ₹4.5 Lakhs</option>
                    <option value="800000">Up to ₹8.0 Lakhs</option>
                    <option value="1000000">Above ₹8 Lakhs</option>
                  </select>
                </div>
              </div>

              <!-- Live Dynamic Calculation Box -->
              <div class="screener-result-box">
                <div class="screener-result-top">
                  <div>
                    <span class="screener-result-count" id="hero-screener-count">50 Schemes Found</span>
                    <span class="screener-result-desc screener-result-quote">The right opportunity starts with the right information.</span>
                  </div>
                </div>
              </div>

              <button type="button" id="hero-screener-submit" class="btn btn-primary btn-block btn-screener">
                View Matching Schemes &amp; Criteria →
              </button>
            </form>

            <div class="screener-card-footer">
              <span>🛡️ No registration required • Privacy protected</span>
            </div>

          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- Section: Ministry & Official Source Accreditation Ticker -->
  <section class="ministry-ticker-section" aria-label="Official Verification Sources">
    <div class="container">
      <p class="ticker-heading">VERIFIED GUIDELINES FROM RECOGNIZED CENTRAL &amp; STATE MINISTRIES</p>
      <div class="ministry-logo-grid">
        <div class="ministry-item">
          <span class="ministry-seal">🏛️</span>
          <span>Ministry of Education (MoE)</span>
        </div>
        <div class="ministry-item">
          <span class="ministry-seal">⚖️</span>
          <span>Ministry of Social Justice</span>
        </div>
        <div class="ministry-item">
          <span class="ministry-seal">🎓</span>
          <span>AICTE Student Welfare</span>
        </div>
        <div class="ministry-item">
          <span class="ministry-seal">📜</span>
          <span>University Grants Commission (UGC)</span>
        </div>
        <div class="ministry-item">
          <span class="ministry-seal">🏹</span>
          <span>Ministry of Tribal Affairs</span>
        </div>
        <div class="ministry-item">
          <span class="ministry-seal">💳</span>
          <span>Vidya Lakshmi Education Loans</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Section: Statistics & Civic Trust -->
  <section class="trust-stats-section" hidden>
    <div class="container">
      <div class="trust-stats-grid">
        <div class="trust-stat-card">
          <div class="trust-stat-num">50+</div>
          <div class="trust-stat-lbl">Verified Scheme Records</div>
          <p class="trust-stat-sub">Central, State &amp; Special Group Portals</p>
        </div>

        <div class="trust-stat-card">
          <div class="trust-stat-num">₹1,250+ Cr</div>
          <div class="trust-stat-lbl">Disbursed Through Official Portals</div>
          <p class="trust-stat-sub">Direct Benefit Transfer (DBT) to Students</p>
        </div>

        <div class="trust-stat-card">
          <div class="trust-stat-num">100%</div>
          <div class="trust-stat-lbl">Direct Official Redirection</div>
          <p class="trust-stat-sub">Authentic application links to genuine portals</p>
        </div>

        <div class="trust-stat-card">
          <div class="trust-stat-num">6 Languages</div>
          <div class="trust-stat-lbl">Multilingual Assistance</div>
          <p class="trust-stat-sub">English, हिन्दी, मराठी, বাংলা, தமிழ், తెలుగు</p>
        </div>
      </div>

      <div class="trust-banner-note">
        <span class="trust-note-icon">ℹ️</span>
        <p>
          <strong>Official Transparency Advisory:</strong> SchemeMatch provides explainable criteria calculation based on gazette notifications. Applications and disbursements are processed strictly on official portals (National Scholarship Portal, AICTE, Vidya Lakshmi, and State Portals).
        </p>
      </div>
    </div>
  </section>

  <!-- Section: About the Team -->
  <section id="about" class="about-section section-py">
    <div class="container">
      <div class="section-header">
        <div class="about-team-name">TEAM SYNTAX//ERROR</div>
        <h2 class="section-title">About <span>SchemeMatch</span></h2>
        <p class="section-desc">SchemeMatch is designed and developed by Karan Rajput and Akanksha Shrivastava to make discovering relevant government schemes simpler, clearer, and more accessible.</p>
        <div class="about-college-label">MITS</div>
      </div>

      <div class="about-team-grid">
        <article class="about-team-card">
          <div class="about-team-initial">KR</div>
          <div class="about-team-content">
            <h3>Karan Rajput</h3>
            <p class="about-team-role">Co-Developer &amp; UI Designer</p>
